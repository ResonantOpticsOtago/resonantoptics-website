@article{christensen_newtons_2025,
 abstract = {In this study, we build upon our earlier research on distance calibration using Newton&#x2019;s rings [Opt. Lett.47, 6053 (2022)10.1364/OL.474539] in a disc-shaped whispering gallery mode resonator (WGMR). Here, we use a glass trapezoidal prism coupler to evanescently trap light in a disc of calcium fluoride (CaF2) WGMR. While sweeping the distance between the coupler and the WGMR, the back of the trapezoidal prism is illuminated with a red-green-blue (RGB) lamp. Microscopic color images of the Newton&#x2019;s rings formed between the resonator and the coupler are captured using a camera. The resonator-prism distance is measured by fitting the color images via phase extraction from the Newton&#x2019;s rings. This modified method removes the ambiguity inherent in the interferometric distance measurement with monochromatic light and allows for the determination of distance with a single image, which results in a distance error of a few nanometers. We show that by including a position reference, we can further improve the accuracy to less than a tenth of a nanometer. Additionally, this technique eliminates the need for filters and offers more precision, owing to broad spectrum coverage of the RGB imaging, better signal-to-noise ratio, and three distinct color channels.},
 author = {Christensen, Josh T. and Trainor, Luke S. and Azeem, Farhan and Sedlmeir, Florian and Strekalov, Dmitry V. and Schwefel, Harald G. L.},
 copyright = {© 2025 Optica Publishing Group},
 doi = {10.1364/OL.572001},
 issn = {1539-4794},
 journal = {Optics Letters},
 keywords = {Absolute distance measurement, Laser resonators, Optical resonators, Phase imaging, Prisms, Whispering gallery modes},
 language = {EN},
 month = {December},
 number = {23},
 pages = {7215--7218},
 publisher = {Optica Publishing Group},
 title = {Newton’s rings for absolute distance measurement},
 url = {https://opg.optica.org/ol/abstract.cfm?uri=ol-50-23-7215},
 urldate = {2025-11-19},
 volume = {50},
 year = {2025}
}

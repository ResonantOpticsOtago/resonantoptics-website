@article{du_toward_2026,
 abstract = {We demonstrate laser refrigeration of a millimeter-scale crystalline whispering-gallery-mode (WGM) resonator fabricated from 10% \p̌hantom\\rm Yb\textasciicircum3+\:YLF, operating at atmospheric pressure. Under resonant pumping at 1031 nm, the resonator exhibits a measurable temperature reduction of \sim 0.5\ K below room temperature with an input power of only 100 mW, corresponding to a temperature drop rate of about 4.8 K/W. Although the present undercoupled configuration yields an effective cavity enhancement factor close to unity, these results represent the experimental demonstration of optical refrigeration in a crystalline WGM resonator. This work establishes crystalline WGMs as a viable platform for thermally stable rare-earth doped photonic devices, and with optimized coupling conditions, significantly deeper cooling and improved performance are expected for applications in precision photonics and quantum technologies.},
 author = {Du, Jinjin and Zhang, Rong and Yuan, Zhenghan and Laplane, Cyril and Trainor, Luke S. and Schwefel, Harald G. L. and Twamley, Jason},
 copyright = {© 2026 The Author(s). Laser & Photonics Reviews published by Wiley-VCH GmbH.},
 doi = {10.1002/lpor.72085},
 issn = {1863-8899},
 journal = {Laser & Photonics Reviews},
 language = {en},
 month = {October},
 number = {n/a},
 pages = {e72085},
 title = {Toward Low-Power Laser Refrigeration - Cooling a Resonant WGM Crystalline Cavity},
 url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/lpor.72085},
 urldate = {2026-10-29},
 volume = {n/a},
 year = {2026}
}

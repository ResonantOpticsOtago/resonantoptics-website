@article{sprenger_caf2_2010,
 abstract = {A fiber laser is stabilized by introducing a calcium fluoride (CaF2) whispering-gallery-mode resonator as a filtering element in a ring cavity. It is set up using a semiconductor optical amplifier as a gain medium. The resonator is critically coupled through prisms, and used as a filtering element to suppress the laser linewidth. A three-cornered-hat method is used and shows a stability of 10−11 after 10μs. Using the self-heterodyne beat technique, the linewidth is determined to be 13kHz. This implies an enhancement factor of 103 with respect to the passive cavity linewidth.},
 author = {Sprenger, B. and Schwefel, H. G. L. and Lu, Z. H. and Svitlov, S. and Wang, L. J.},
 doi = {10.1364/OL.35.002870},
 journal = {Optics Letters},
 keywords = {Fibers, erbium, Laser stabilization, Lasers, fiber, Wavelength filtering devices},
 number = {17},
 pages = {2870--2872},
 title = {CaF2 whispering-gallery-mode-resonator stabilized-narrow-linewidth laser},
 url = {http://ol.osa.org/abstract.cfm?URI=ol-35-17-2870},
 urldate = {2010-08-19},
 volume = {35},
 year = {2010}
}

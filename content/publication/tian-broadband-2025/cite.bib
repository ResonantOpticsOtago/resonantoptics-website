@article{tian_broadband_2025,
 abstract = {Lithium tetraborate (LB4) is a nonlinear crystal that has very low optical absorption in the visible and ultraviolet range. Hence, it is a very interesting material for nonlinear conversion experiments, particularly in whispering gallery mode (WGM) resonators. Here, we show theoretically that second-harmonic generation is possible over a wide range of pump wavelengths (488nm to 3320nm) in an x-cut LB4 WGM resonator. We also demonstrate this experimentally at three different pump wavelengths (1560nm, 795nm, and 517nm). We find a reasonable conversion efficiency of 0.2%/mW for the generation of UV light at 258.5nm. This is possible due to the high-quality factors on the order of 5×107 and the use of the so-called selective coupling method.},
 author = {Tian, Chengcai and Becker, Petra and Bohatý, Ladislav and Blaikie, Richard and Schwefel, Harald G. L. and Sedlmeir, Florian},
 copyright = {© 2025 Optica Publishing Group},
 doi = {10.1364/OL.567843},
 issn = {1539-4794},
 journal = {Optics Letters},
 keywords = {Laser induced damage thresholds, Nonlinear optical crystals, Nonlinear optical materials, Optical absorption, Periodically poled lithium niobate, Q factor},
 language = {EN},
 month = {September},
 number = {17},
 pages = {5246--5249},
 publisher = {Optica Publishing Group},
 title = {Broadband second-harmonic generation in an x-cut lithium tetraborate whispering gallery mode resonator},
 url = {https://opg.optica.org/ol/abstract.cfm?uri=ol-50-17-5246},
 urldate = {2025-08-20},
 volume = {50},
 year = {2025}
}
